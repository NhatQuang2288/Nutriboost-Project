{
  "name": "nutriboost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NutriBoost — trợ lý dinh dưỡng AI-Native, mobile-first PWA",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nutriboost/web",
    "build": "npm run build -w @nutriboost/web",
    "start": "npm run start -w @nutriboost/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:check": "node scripts/check-migrations.mjs",
    "env:check": "node scripts/check-env.mjs",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "seed": "tsx packages/seed/src/cli.ts",
    "eval": "tsx packages/ai/src/eval/run.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
