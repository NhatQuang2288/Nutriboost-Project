# ============================================================================
# NutriBoost — biến môi trường
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# `.env.local` đã bị .gitignore chặn. KHÔNG bao giờ commit khoá thật.
#
# SAU KHI ĐIỀN, CHẠY THÊM:
#     npm run env:link
#
# Bắt buộc. Next.js chỉ đọc .env.local trong apps/web, không đọc ở gốc monorepo.
# Bỏ qua bước này thì web vẫn khởi động nhưng không thấy khoá nào, và trợ lý Bơ
# im lặng trả lời mặc định — không có lỗi nào hiện ra để mà lần theo.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — bắt buộc
# Lấy ở: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server. Bỏ qua khoá này cũng được nếu không chạy seed/script quản trị.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Gemini — bắt buộc để dùng trợ lý Bơ
# Lấy ở: https://aistudio.google.com/apikey
#
# LƯU Ý QUAN TRỌNG VỀ QUYỀN RIÊNG TƯ:
# Ở gói miễn phí, Google được phép dùng nội dung để cải thiện sản phẩm.
# KHÔNG dùng gói miễn phí cho dữ liệu sức khoẻ thật của người dùng.
# Lấy khoá ở https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Ghi đè địa chỉ API. Bỏ trống thì dùng https://api.deepseek.com
# Đặt khi trỏ qua proxy nội bộ hoặc một máy chủ tương thích OpenAI khác.
DEEPSEEK_BASE_URL=

# ---------------------------------------------------------------------------
# Định tuyến model — mặc định đã tối ưu chi phí
#   Tác vụ khối lượng lớn, đầu ra ngắn    → deepseek-flash
#   Tác vụ cần chất lượng (kế hoạch tuần) → deepseek-v4-pro
#
# Cả hai đều hỗ trợ JSON Output và Tool Calls, nên đường gọi có cấu trúc dùng được với cả hai.
#
# Bảng giá dùng để tính `ai_calls.cost_usd` nằm ở packages/ai/src/prices.ts.
# LƯU Ý: DeepSeek tính MỘT NỬA GIÁ ngoài giờ cao điểm (cao điểm là 01:00–04:00 và
# 06:00–10:00 UTC, thứ Hai tới thứ Sáu). Bảng giá mã hoá cả hai mức.
# ---------------------------------------------------------------------------
AI_MODEL_FAST=deepseek-flash
AI_MODEL_QUALITY=deepseek-v4-pro

# ---------------------------------------------------------------------------
# Trần chi phí AI
# AI_DAILY_BUDGET_USD: trần mềm mỗi người dùng mỗi ngày. Cảnh báo ở 80 %.
# AI_KILL_SWITCH=true : tắt toàn bộ lời gọi AI mà không cần deploy lại.
# ---------------------------------------------------------------------------
AI_DAILY_BUDGET_USD=0.02
AI_KILL_SWITCH=false

# Giới hạn số lượt gọi mỗi người dùng mỗi ngày theo từng mục đích.
AI_LIMIT_PARSE_PER_DAY=40
# `estimate_meal` có biến RIÊNG. Trước đây nó đọc chung `AI_LIMIT_PARSE_PER_DAY`, nên đặt
# hạn mức cho việc phân tích bữa ăn lại âm thầm đổi luôn hạn mức ước lượng.
AI_LIMIT_ESTIMATE_PER_DAY=60
AI_LIMIT_PLAN_PER_DAY=3
AI_LIMIT_CHAT_PER_DAY=40
AI_LIMIT_INSIGHT_PER_DAY=1

# ---------------------------------------------------------------------------
# Ứng dụng
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Múi giờ mặc định cho hồ sơ mới — quyết định cách tính "ngày hôm nay".
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------------
# Tuỳ chọn — để trống thì các tính năng tương ứng tự tắt
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Chỉ dùng khi chạy test E2E với Supabase local
# ---------------------------------------------------------------------------
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
